<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FEF7FF"
    app:cardCornerRadius="20dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp">

        <View
            android:id="@+id/shimmerImage"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/shimmerBadge"
            android:layout_width="70dp"
            android:layout_height="20dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_product_category_bage"
            app:layout_constraintBottom_toBottomOf="@id/shimmerImage"
            app:layout_constraintStart_toStartOf="@id/shimmerImage" />

        <View
            android:id="@+id/shimmerPrice"
            android:layout_width="100dp"
            android:layout_height="18dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerImage" />

        <View
            android:id="@+id/shimmerName"
            android:layout_width="130dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerPrice" />

        <View
            android:id="@+id/shimmerArticle"
            android:layout_width="60dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_shimmer_rounded"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmerName" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>