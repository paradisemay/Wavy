<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/tab_products">

    <navigation
        android:id="@+id/tab_products"
        app:startDestination="@id/productListFragment">
        <fragment
            android:id="@+id/productDetailsFragment"
            android:name="tech.timoapp.wavy.ProductDetailsFragment"
            android:label="ProductDetailsFragment" />
        <fragment
            android:id="@+id/productListFragment"
            android:name="tech.timoapp.wavy.ProductListFragment"
            android:label="ProductListFragment">
            <action
                android:id="@+id/action_productListFragment_to_productDetailsFragment"
                app:destination="@id/productDetailsFragment" />
        </fragment>
    </navigation>

    <navigation
        android:id="@+id/tab_reviews"
        app:startDestination="@id/reviewsFragment">
        <fragment
            android:id="@+id/reviewsFragment"
            android:name="tech.timoapp.wavy.ReviewsFragment"
            android:label="ReviewsFragment" />
    </navigation>
</navigation>